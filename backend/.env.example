# Database
DATABASE_URL=sqlite:///./settleops.db

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Business rules
CHARGE_RATE=0.41
DEFAULT_GST_RATE=0

# Gmail OAuth (drop credentials.json in ./secrets/, set the path here)
GMAIL_CLIENT_SECRETS_FILE=./secrets/credentials.json
GMAIL_TOKEN_FILE=./secrets/token.json
# Optional: search query used to discover bank statement emails
GMAIL_SEARCH_QUERY=from:bank has:attachment newer_than:7d
# Optional: how often the background scheduler polls Gmail (cron-style or seconds)
GMAIL_SYNC_INTERVAL_MINUTES=30

# Telegram bot (create via @BotFather on Telegram, paste token below)
TELEGRAM_BOT_TOKEN=
# Where reports get sent. Get a chat id by adding the bot to a chat and calling /api/telegram/sync once.
TELEGRAM_REPORT_CHAT_ID=
# Comma-separated allowlist of chat ids the bot will accept file uploads from. Empty = accept all.
TELEGRAM_INBOUND_CHAT_IDS=
# Poll interval for incoming bank statements. 0 disables inbound polling.
TELEGRAM_SYNC_INTERVAL_MINUTES=10
# Optional daily-digest cron, e.g. "30 18 * * *" for 18:30 every day. Empty = no scheduled digest.
TELEGRAM_DIGEST_CRON=

# App
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true
APP_LOG_LEVEL=info
