# Copy this file to `.env` on the production server next to docker-compose.yml.
# Docker Compose reads .env automatically — do NOT commit the real .env.

# --- HOST PORT ---
# Public port the frontend container binds to. Behind a reverse proxy (Caddy/Traefik/
# nginx-host) leave at 80; otherwise pick something like 8080.
HOST_PORT=80

# --- DATABASE ---
# Default is SQLite on the named volume. To use Postgres:
#   DATABASE_URL=postgresql+psycopg://user:pass@db:5432/settleops
DATABASE_URL=sqlite:////app/data/settleops.db

# --- CORS ---
# Comma-separated list of origins the API will accept. Include the public domain
# of the frontend.
CORS_ORIGINS=https://yourdomain.com,http://localhost

# --- AUTH ---
SEED_USERNAME=deep7835
SEED_PASSWORD=Deep@1234-=
# Generate with: openssl rand -base64 48
# If left empty the backend creates a fresh random secret on every container restart
# (every restart logs everyone out). Set this for stable sessions.
JWT_SECRET=
JWT_EXPIRES_HOURS=168

# --- GMAIL ---
GMAIL_SEARCH_QUERY=from:bank has:attachment newer_than:2d
GMAIL_SYNC_INTERVAL_MINUTES=30

# --- TELEGRAM ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_REPORT_CHAT_ID=
TELEGRAM_INBOUND_CHAT_IDS=
TELEGRAM_SYNC_INTERVAL_MINUTES=10
TELEGRAM_DIGEST_CRON=

# --- APP ---
APP_LOG_LEVEL=info
